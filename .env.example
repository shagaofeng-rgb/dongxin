# Canonical public URL used by sitemap and robots after deployment.
NEXT_PUBLIC_SITE_URL=https://qzdxrv.com

# Supabase website operations backend. Never expose the service-role key in browser code.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used only by the one-time, local administrator provisioning command.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=choose-a-strong-temporary-password
