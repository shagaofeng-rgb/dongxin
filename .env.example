# Canonical public URL used by sitemap and robots after deployment.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Server-only Resend key used to forward website form submissions.
RESEND_API_KEY=
# Optional verified sender. Defaults to Website Forms <info@qzdxrv.com>.
RESEND_FROM_EMAIL=Website Forms <info@qzdxrv.com>
